# WealthVault-AI Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your local environment.

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Debug Mode (set to false in production)
DEBUG=true

# Application Metadata
PROJECT_NAME=WealthVault-AI
VERSION=0.1.0

# API Routing
API_V1_STR=/api/v1

# CORS Origins (JSON list or comma-separated strings)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Server Configuration
HOST=0.0.0.0
PORT=8000
